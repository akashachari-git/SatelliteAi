# Storage runtime generated files (keep directory structure with .gitkeep)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/processed/*
!backend/storage/processed/.gitkeep
backend/storage/evidence/*
!backend/storage/evidence/.gitkeep
backend/storage/reports/*
!backend/storage/reports/.gitkeep
backend/storage/scratch_*
backend/storage/sessions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
