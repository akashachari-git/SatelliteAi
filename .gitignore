# Environment variables and credentials
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!**/.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/
venv/
.venv/
env/
*.egg-info/
dist/
build/

# Node & Frontend
node_modules/
**/node_modules/
dist/
**/dist/
frontend/dist/
.vite/
**/.vite/
*.timestamp-*.mjs
