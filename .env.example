# SatQuery AI - Environment Configuration Template
# Copy this file to .env and configure for your local or production environment.

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
# Base URL for the FastAPI backend API.
# In local development: http://localhost:8000
# In production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# -----------------------------------------------------------------------------
# Port for the FastAPI server to listen on.
PORT=8000

# Comma-separated list of allowed CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local model checkpoint directories (defaults will work if left blank).
FLORENCE2_CHECKPOINT_DIR=backend/models/checkpoints/florence2-base
BIGEARTHNET_MODEL_PATH=backend/models/checkpoints/bigearthnet/bigearthnet_resnet18_10band.onnx

# -----------------------------------------------------------------------------
# Optional Benchmark Dataset Directories
# -----------------------------------------------------------------------------
# If you have downloaded public benchmark archives, specify their root paths:
BIGEARTHNET_ROOT=
RSVQA_ROOT=
VRSBENCH_ROOT=
CDVQA_ROOT=
